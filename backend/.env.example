# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-string

# Optional. Defaults to 3600000 (1 hour) in milliseconds.
JWT_EXPIRATION=3600000

# Local PostgreSQL connection.
DB_NAME=money_manager
DB_URL=jdbc:postgresql://localhost:5432/money_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# dev only: update (Hibernate auto-DDL). prod defaults to validate.
DDL_AUTO=update

# dev only. Ignored in prod.
H2_CONSOLE_ENABLED=true

# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
