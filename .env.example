# Full-stack Docker Compose settings.
# Copy this file to .env in the repository root and fill in the values.
# .env is gitignored and must never be committed.

POSTGRES_DB=money_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-string
JWT_EXPIRATION=3600000

# Host ports. The frontend is served at http://localhost:${FRONTEND_PORT}.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Leave empty to call the backend through Nginx on the same origin (recommended).
# Set to http://localhost:8080 only if the frontend should call the backend directly.
VITE_API_BASE_URL=

# Browser origins allowed to call the backend directly. Same-origin Nginx proxy
# requests do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
